# Copy this file to .env and fill in whichever keys you have.
# .env is gitignored. Keys stay on this machine - the app never sends them
# anywhere except to the provider you select.
#
# You need ZERO keys to start if you run Ollama locally.

# --- Anthropic ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-4-8

# --- OpenAI ---
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

# --- OpenRouter (one key, many open-weight models) ---
OPENROUTER_API_KEY=
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct

# --- xAI / Grok ---
XAI_API_KEY=
XAI_MODEL=grok-4

# --- Ollama (local, no key needed; requires Ollama running) ---
OLLAMA_MODEL=llama3.1:8b

# --- app ---
REVERIEBOT_PORT=8765
