# secrets - never commit
.env

# vendored third-party tools (large binaries, fetched by scripts/setup.ps1)
vendor/*
!vendor/.gitkeep

# saved research artifacts are personal by default
workspace/*
!workspace/.gitkeep

# local session ledgers (queries, evidence, redacted traffic) are personal
sessions/*
!sessions/.gitkeep

# local memory / skill-proposal store is personal
memory/*
!memory/.gitkeep

# python
__pycache__/
*.pyc
.venv/

# PyInstaller build output
build/
dist/

# os
Thumbs.db
desktop.ini

# local design-review artifacts
.superpowers/
